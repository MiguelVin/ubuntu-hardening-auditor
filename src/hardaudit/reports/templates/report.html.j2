<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>hardaudit report · {{ report.target }}</title>
<style>
  :root {
    --bg: #f6f7f9; --card: #ffffff; --text: #1c2330; --muted: #5d6778; --line: #e2e6ec;
    --code: #f0f2f5; --pass: #1a7f4b; --fail: #c62828; --skip: #9a6700; --error: #8e24aa;
    --critical: #b71c1c; --high: #d84315; --medium: #b7791f; --low: #2f6f9f;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0f1318; --card: #171c23; --text: #e6e9ee; --muted: #98a2b3; --line: #2a313b;
      --code: #0f1318; --pass: #4cc38a; --fail: #ff6b6b; --skip: #e3b341; --error: #d58cf0;
      --critical: #ff6b6b; --high: #ff8a50; --medium: #e3b341; --low: #6cb6ff;
    }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--text);
         font: 15px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
  main { max-width: 1100px; margin: 0 auto; padding: 32px 16px 48px; }
  h1 { margin: 0 0 4px; font-size: 26px; }
  h2 { margin: 36px 0 12px; font-size: 19px; }
  .muted { color: var(--muted); }
  .card { background: var(--card); border: 1px solid var(--line); border-radius: 12px; }
  .summary { display: flex; flex-wrap: wrap; gap: 24px; align-items: center;
             padding: 24px; margin-top: 20px; }
  .ring { --pct: {{ report.score or 0 }}; width: 128px; height: 128px; border-radius: 50%;
          display: grid; place-items: center; flex: none;
          background: conic-gradient(var(--score-colour) calc(var(--pct) * 1%), var(--line) 0); }
  .ring > div { width: 100px; height: 100px; border-radius: 50%; background: var(--card);
                display: grid; place-items: center; text-align: center; line-height: 1.1; }
  .ring strong { font-size: 32px; display: block; }
  .stats { display: flex; flex-wrap: wrap; gap: 12px; }
  .stat { padding: 10px 16px; border-radius: 10px; background: var(--code); min-width: 92px; }
  .stat b { display: block; font-size: 22px; }
  .filters { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 12px; }
  .filters button { border: 1px solid var(--line); background: var(--card); color: var(--text);
                    border-radius: 999px; padding: 6px 14px; cursor: pointer; font: inherit; }
  .filters button.active { border-color: var(--text); font-weight: 600; }
  .table-wrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; }
  th, td { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--line);
           vertical-align: top; }
  th { font-size: 13px; color: var(--muted); font-weight: 600; }
  tr:last-child td { border-bottom: none; }
  .badge { display: inline-block; padding: 2px 8px; border-radius: 6px; font-size: 12px;
           font-weight: 700; letter-spacing: .03em; color: #fff; }
  .s-pass { background: var(--pass); } .s-fail { background: var(--fail); }
  .s-skip { background: var(--skip); } .s-error { background: var(--error); }
  .sev { font-weight: 600; }
  .sev-critical { color: var(--critical); } .sev-high { color: var(--high); }
  .sev-medium { color: var(--medium); } .sev-low { color: var(--low); }
  code, pre { font-family: ui-monospace, "Cascadia Code", Consolas, monospace; font-size: 13px; }
  .id { white-space: nowrap; color: var(--muted); }
  .detail { word-break: break-word; }
  .fix { padding: 16px 20px; margin-bottom: 12px; }
  .fix h3 { margin: 0 0 8px; font-size: 16px; }
  pre { background: var(--code); border: 1px solid var(--line); border-radius: 8px;
        padding: 12px; overflow-x: auto; margin: 8px 0 0; }
  .comment { color: var(--muted); }
  a { color: var(--low); }
  footer { margin-top: 40px; font-size: 13px; }
</style>
</head>
<body>
<main>
  <h1>hardaudit report</h1>
  <div class="muted">Target <code>{{ report.target }}</code> · {{ report.generated_at }} · hardaudit {{ report.version }}</div>

  <section class="card summary" style="--score-colour: var(--{{ ring_colour }})">
    <div class="ring"><div>
      <div><strong>{{ report.score if report.score is not none else "N/A" }}</strong><span class="muted">/ 100</span></div>
    </div></div>
    <div>
      <div style="font-size:20px;font-weight:700">{{ report.grade }}</div>
      <div class="muted" style="margin-bottom:12px">{{ report.evaluated }} of {{ report.total }} checks evaluated</div>
      <div class="stats">
        <div class="stat"><b style="color:var(--pass)">{{ report.counts.pass }}</b>passed</div>
        <div class="stat"><b style="color:var(--fail)">{{ report.counts.fail }}</b>failed</div>
        <div class="stat"><b style="color:var(--skip)">{{ report.counts.skip }}</b>skipped</div>
        <div class="stat"><b style="color:var(--error)">{{ report.counts.error }}</b>errors</div>
      </div>
    </div>
  </section>

  <h2>Checks</h2>
  <div class="filters" role="group" aria-label="Filter by status">
    <button class="active" data-filter="all">All</button>
    <button data-filter="fail">Failed</button>
    <button data-filter="pass">Passed</button>
    <button data-filter="skip">Skipped</button>
  </div>
  <div class="card table-wrap">
    <table>
      <thead><tr><th>Status</th><th>ID</th><th>Check</th><th>Severity</th><th>Detail</th><th>MITRE ATT&amp;CK</th></tr></thead>
      <tbody>
      {% for r in report.results %}
        <tr data-status="{{ r.status }}">
          <td><span class="badge s-{{ r.status }}">{{ r.status | upper }}</span></td>
          <td class="id"><code>{{ r.id }}</code></td>
          <td>{{ r.title }}</td>
          <td class="sev sev-{{ r.severity }}">{{ r.severity }}</td>
          <td class="detail">{{ r.detail }}</td>
          <td>{% for t in r.mitre %}<a href="{{ t | mitre_url }}" target="_blank" rel="noopener">{{ t }}</a>{% if not loop.last %}, {% endif %}{% endfor %}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>

  {% set failures = report.results | selectattr("status", "equalto", "fail") | list %}
  {% if failures %}
  <h2>How to fix</h2>
  {% for r in failures %}
    <div class="card fix">
      <h3><span class="sev sev-{{ r.severity }}">{{ r.id }}</span> · {{ r.title }}</h3>
      <div class="muted">{{ r.detail }}</div>
      <pre>{% for line in r.remediation %}{% if line.startswith("#") %}<span class="comment">{{ line }}</span>{% else %}$ {{ line }}{% endif %}
{% endfor %}</pre>
    </div>
  {% endfor %}
  {% endif %}

  <footer class="muted">
    Review every command before running it. For educational use on systems you own or are authorized to audit.
  </footer>
</main>
<script>
  document.querySelectorAll(".filters button").forEach(function (button) {
    button.addEventListener("click", function () {
      document.querySelectorAll(".filters button").forEach(function (b) { b.classList.remove("active"); });
      button.classList.add("active");
      var wanted = button.dataset.filter;
      document.querySelectorAll("tbody tr").forEach(function (row) {
        row.hidden = wanted !== "all" && row.dataset.status !== wanted;
      });
    });
  });
</script>
</body>
</html>
